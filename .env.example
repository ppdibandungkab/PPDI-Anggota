# GEMINI_API_KEY: Required for Gemini AI API calls.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
APP_URL="MY_APP_URL"

# MySQL Database Configuration (Dikonfigurasi manual melalui .env)
DB_HOST=""
DB_PORT="3306"
DB_USER=""
DB_PASSWORD=""
DB_NAME=""

# Frontend React + Vite -> Backend Laravel API Configuration
# Kosongkan ("") jika React & Laravel berjalan di domain yang sama (Single-Domain HestiaCP)
# Isi URL penuh tanpa trailing slash jika beda subdomain, mis. "https://api.ppdi-bandungkab.id"
VITE_API_URL=""
# Set "true" hanya jika menggunakan cookie session / Laravel Sanctum lintas subdomain (CORS_ALLOWED_ORIGINS tidak boleh *)
VITE_API_WITH_CREDENTIALS="false"