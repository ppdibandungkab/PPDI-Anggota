APP_NAME="PPDI Kabupaten Bandung"
APP_ENV=production
APP_KEY=
APP_DEBUG=false
APP_TIMEZONE=Asia/Jakarta
APP_LOCALE=id
APP_URL=https://ppdi.domain-anda.id
FORCE_HTTPS=true

LOG_CHANNEL=daily
LOG_LEVEL=warning

DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=serverpp_db_anggota
DB_USERNAME=serverpp_opensid
DB_PASSWORD=
DB_TIMEZONE=+07:00

# Mode penyimpanan upload di shared hosting:
# - public  : langsung ke public/uploads/{foto,sk,ttd,regulasi} (AMAN tanpa perlu symlink storage:link)
# - storage : ke storage/app/public/uploads (dilayani via symlink atau fallback route Laravel)
UPLOADS_STORAGE_MODE=public

# Konfigurasi CORS:
# - Single-domain (React di public/spa.html): boleh "*" dengan CORS_SUPPORTS_CREDENTIALS=false
# - Split-domain (mis. https://ppdi.domain-anda.id -> https://api.domain-anda.id):
#   WAJIB isi origin spesifik tanpa trailing slash jika CORS_SUPPORTS_CREDENTIALS=true
CORS_ALLOWED_ORIGINS=*
CORS_SUPPORTS_CREDENTIALS=false

# Masa berlaku signed Bearer token sesi API (dalam jam)
AUTH_TOKEN_TTL_HOURS=24

# Password fallback admin lokal (jika tabel users belum tersedia)
ADMIN_PASSWORD=admin

# Set true jika ingin memigrasikan password baru ke bcrypt saat pengguna ganti password
HASH_PASSWORDS=false

# Set true untuk memblokir ganti password apabila kolom updated_at pada users masih NULL
# (aktivasi awal password default PPDIJaya#2006 tetap diizinkan agar pengguna baru dapat masuk)
STRICT_PASSWORD_UPDATED_AT_CHECK=false

SESSION_DRIVER=file
CACHE_STORE=file
QUEUE_CONNECTION=sync
FILESYSTEM_DISK=public
