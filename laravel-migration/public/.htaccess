<IfModule mod_rewrite.c>
    <IfModule mod_negotiation.c>
        Options -MultiViews -Indexes
    </IfModule>

    RewriteEngine On

    # 1. Blokir akses langsung ke file sensitif di shared hosting
    RewriteRule ^(\.env|\.git|composer\.(json|lock)|artisan|package\.json) - [F,L,NC]

    # 2. Pertahankan header Authorization & X-XSRF-Token pada Apache FastCGI / PHP-FPM (HestiaCP)
    RewriteCond %{HTTP:Authorization} .
    RewriteRule .* - [E=HTTP_AUTHORIZATION:%{HTTP:Authorization}]

    RewriteCond %{HTTP:x-xsrf-token} .
    RewriteRule .* - [E=HTTP_X_XSRF_TOKEN:%{HTTP:X-XSRF-Token}]

    # 3. Redirect Trailing Slashes jika bukan direktori fisik
    RewriteCond %{REQUEST_FILENAME} !-d
    RewriteCond %{REQUEST_URI} (.+)/$
    RewriteRule ^ %1 [L,R=301]

    # 4. Layani file statis fisik (/assets/*, /uploads/*, favicon, svg) secara langsung,
    #    dan arahkan seluruh rute API serta SPA React (termasuk saat refresh halaman) ke index.php
    RewriteCond %{REQUEST_FILENAME} !-d
    RewriteCond %{REQUEST_FILENAME} !-f
    RewriteRule ^ index.php [L]
</IfModule>

# Header keamanan ringan untuk shared hosting
<IfModule mod_headers.c>
    Header always set X-Content-Type-Options "nosniff"
    Header always set Referrer-Policy "strict-origin-when-cross-origin"
</IfModule>
